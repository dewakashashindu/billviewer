<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     web.config — SmarterASP.NET classic hosting (IIS + httpPlatform)
     IIS passes ALL requests to `node server.js`.
     PORT is dynamic on shared hosting — never set a fixed PORT here
     or in .env.production.
     NOTE: real secrets (DB_PASSWORD, ENCRYPTION_KEY) go in
     .env.production or .env.local on the server — do NOT commit them.
     ============================================================ -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    <httpPlatform processPath="node"
                  arguments="server.js"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\log.txt">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="0.0.0.0" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
