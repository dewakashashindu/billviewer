# ============================================================
# billviewer — environment template
# Copy this to `.env.local` and fill in the values.
#   cp .env.example .env.local
# (.env.local is git-ignored — never commit real credentials)
# ============================================================

# ── Bill link encryption ─────────────────────────────────────
# EXACTLY 16 characters.
# ⚠️ Meka Windows service eke thiyana key ekama wenna one —
#    service eken encrypt wela ena links decrypt karanna.
ENCRYPTION_KEY=MyLocalDevKey123

# ── MSSQL database (SmarterASP.NET) ──────────────────────────
# Control Panel → Databases → (your MSSQL DB) → connection info
# e.g. sql6020.site4now.net / sql5008.smarterasp.net
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# TLS options — defaults are fine for SmarterASP.
# Only change if the server rejects encrypted connections.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ── Reports ──────────────────────────────────────────────────
# Transaction Summary report eka ganna view/table eka
SALES_SUMMARY_VIEW=VW_SalesSummery
